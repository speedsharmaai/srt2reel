    {
      "s": 0.2,
      "e": 2.05,
      "t": "Maya wanted to\nrun a {marathon}."
    },
    {
      "s": 2.64,
      "e": 4.38,
      "t": "She told {everyone}\nat the office."
    },
    {
      "s": 4.99,
      "e": 7.99,
      "t": "\"I'm going to run {forty-two}\nkilometres,\" she said.",
      "who": "Maya"
    },
    {
      "s": 8.59,
      "e": 11.25,
      "t": "Everyone clapped. It\nalready felt like {winning}."
    },
    {
      "s": 11.84,
      "e": 14.02,
      "t": "But the next morning,\nshe {stayed in bed}."
    },
    {
      "s": 14.64,
      "e": 16.37,
      "t": "A month later,\nsomeone asked,"
    },
    {
      "s": 16.73,
      "e": 18.05,
      "t": "\"How is the\n{training} going?\"",
      "who": "Sam"
    },
    {
      "s": 18.64,
      "e": 20.22,
      "t": "She had {not} run even {once}."
    },
    {
      "s": 20.83,
      "e": 24.01,
      "t": "So she started again, and\nthis time she told {nobody}."
    },
    {
      "s": 24.61,
      "e": 26.64,
      "t": "Every morning,\n{one more} kilometre."
    },
    {
      "s": 27.24,
      "e": 29.97,
      "t": "Six months later, she\ncrossed the {finish line}."
    },
    {
      "s": 30.56,
      "e": 31.55,
      "t": "The lesson is {simple}."
    },
    {
      "s": 32.14,
      "e": 34.52,
      "t": "Do the {work} first.\n{Talk} about it later."
    }
